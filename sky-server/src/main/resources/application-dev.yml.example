# 本地开发配置模板
#
# 使用方法：复制本文件为 application-dev.yml，填入你自己的真实配置。
# application-dev.yml 已被 .gitignore 忽略，不会提交到仓库，请勿把真实密钥写进本模板。
sky:
  jwt:
    # jwt 签名密钥，务必使用足够长的随机字符串，泄露后他人可伪造登录令牌
    admin-secret-key: 请填写随机字符串_例如_openssl_rand_hex_32_的输出
    user-secret-key: 请填写随机字符串_例如_openssl_rand_hex_32_的输出
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: 数据库用户名
    password: 数据库密码
  redis:
    host: localhost
    port: 6379
    password:
    database: 0
  wechat:
    # 微信公众平台 -> 开发管理 -> 开发设置
    appid: 小程序appid
    secret: 小程序密钥
  alioss:
    # 阿里云 OSS，建议使用只有 OSS 权限的 RAM 子账号，不要用主账号 AccessKey
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: 阿里云AccessKeyId
    access-key-secret: 阿里云AccessKeySecret
    bucket-name: 存储桶名称
  shop:
    address: 店铺地址
  baidu:
    # 百度地图开放平台的应用 AK
    ak: 百度地图ak
